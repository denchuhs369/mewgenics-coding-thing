def drawbread():
  t.penup()
  t.forward(150)
  t.pendown()
  t.begin_fill()
  t.pensize(5)
  t.color("#e99021")
  for i in range (3):
    t.right(90)
    t.forward(50)
  for i in range (18):
    t.right(10)
    t.forward(4.38835)
  t.hideturtle()
  t.pensize(1)
  t.color("#ebd17e")
  t.end_fill()
  t.color("green")
  t.left(90)
  x = t.xcor()
  y = t.ycor()
  t.penup()
  t.goto(x + -50, y)
  t.pendown()
  for i in range (5):
    for i in range (9):
      t.penup()
      t.forward(4)
      t.pendown()
      t.forward(1)
    x = t.xcor()
    y = t.ycor()
    t.penup()
    t.goto(x + -45, y + -10)
    t.pendown()
  x = t.xcor()
  y = t.ycor()
  t.penup()
  t.goto(x + -30, y + 60)
  t.pendown()

drawpizza("circle", "bacon")
drawbread()
