import turtle
t = turtle.Turtle()
t.speed(0)
def drawpizza(shape, topping):
  if shape == "square":
  	for i in range (4):
   	  t.forward(50)
   	  t.right(90)
  if shape == "circle":
    t.pensize(5)
    t.begin_fill()
    t.color("#965f26")
    for i in range (20):
   	  t.forward(10)
   	  t.right(18)
    t.penup()
    t.color("#efa220")
    t.end_fill()
    t.pensize(1)
    t.pendown()
  if topping == "bacon":
    t.color("#8a1a0f")
    
    for i in range (3):
      x = t.xcor()
      y = t.ycor()
      t.penup()
      t.goto(x, y - 15)
      t.pendown()
      for i in range (2):
        t.begin_fill()
        t.forward (10)
        t.right(90)
        t.forward(5)
        t.right(90)
        t.end_fill()
        pass
    x = t.xcor()
    y = t.ycor()
    t.penup()
    t.goto(x + 15, y + 50)
    t.pendown()
    for i in range (3):
      x = t.xcor()
      y = t.ycor()
      t.penup()
      t.goto(x, y - 15)
      t.pendown()
      for i in range (2):
        t.begin_fill()
        t.forward (10)
        t.right(90)
        t.forward(5)
        t.right(90)
        t.end_fill()
        pass
    x = t.xcor()
    y = t.ycor()
    t.penup()
    t.goto(x + -30, y + 45)
    t.pendown()
    for i in range (3):
      x = t.xcor()
      y = t.ycor()
      t.penup()
      t.goto(x, y - 15)
      t.pendown()
      for i in range (2):
        t.begin_fill()
        t.forward (10)
        t.right(90)
        t.forward(5)
        t.right(90)
        t.end_fill()
        pass

    
    
drawpizza("circle", "bacon")
